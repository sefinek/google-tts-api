{
  "name": "@sefinek/google-tts-api",
  "version": "2.1.15",
  "description": "Fast Google TTS (Text-To-Speech) for Node.js. For free without any API keys!",
  "keywords": [
    "cloud",
    "google-api-client",
    "google-api",
    "google-apis-client",
    "google-apis",
    "google-cloud-platform",
    "google-cloud",
    "google-texttospeech",
    "google",
    "text-to-speech-api",
    "texttospeech"
  ],
  "homepage": "https://github.com/sefinek/google-tts-api#readme",
  "bugs": {
    "url": "https://github.com/sefinek/google-tts-api/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sefinek/google-tts-api.git"
  },
  "license": "MIT",
  "author": "zlargon",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "directories": {
    "example": "example",
    "test": "test"
  },
  "files": [
    "dist",
    "example",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p .",
    "cover": "npm run build && node --test --experimental-test-coverage --test-timeout=60000",
    "lint": "eslint .",
    "m": "ncu -u && npm install && npm update",
    "test": "npm run build && node --test --test-timeout=60000"
  },
  "dependencies": {
    "axios": "^1.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "is-base64": "^1.1.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
